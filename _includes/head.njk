{% set pageTitle = title or site.title %}
{% set metaDescription = description or site.description %}
{% set metaKeywords = keywords or site.keywords %}
{% set currentUrl = page.url or "" %}
{% set canonicalUrl = canonical or (currentUrl | absoluteUrl(site.url)) %}
{% set metaImagePath = image or site.defaultImage %}
{% set metaImageUrl = metaImagePath | absoluteUrl(site.url) %}
{% set imageAltText = imageAlt or site.imageAlt or pageTitle %}
{% set robotsContent = "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" %}
{% if noindex or currentUrl == "/404.html" or currentUrl == "404.html" %}
  {% set robotsContent = "noindex, follow" %}
{% endif %}
{% set isHome = currentUrl == "/" or currentUrl == "/index.html" or currentUrl == "index.html" %}
{% set isCourseSection = isHome or currentUrl == "/foto-kursove.html" or currentUrl == "foto-kursove.html" or currentUrl.startsWith("/foto-kursove/") or currentUrl.startsWith("foto-kursove/") %}
{% set isPhotographySection = isHome or currentUrl == "/photography.html" or currentUrl == "photography.html" or currentUrl.startsWith("/photography/") or currentUrl.startsWith("photography/") %}
{% set isCourseLanding = currentUrl == "/foto-kursove.html" or currentUrl == "foto-kursove.html" %}

<head>
  <meta charset="utf-8" />
  <meta name="theme-color" content="#A5BD33" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="content-type" content="text/html; charset=utf-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="format-detection" content="telephone=yes" />

  <!-- Performance: Preconnect to external resources -->
  <link rel="preconnect" href="https://ajax.googleapis.com" crossorigin />
  <link rel="preconnect" href="https://code.jquery.com" crossorigin />
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
  <link rel="dns-prefetch" href="https://ajax.googleapis.com" />
  <link rel="dns-prefetch" href="https://code.jquery.com" />
  <link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />

  <!-- Preload critical resources -->
  <link rel="preload" href="{{ pathPrefix }}images/logo.png" as="image" />
  <link rel="preload" href="{{ pathPrefix }}templates/js_wright/wright/bootstrap/css/bootstrap.min.css" as="style" />

  <!-- SEO Meta Tags -->
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ metaDescription }}" />
  {% if metaKeywords %}<meta name="keywords" content="{{ metaKeywords }}" />{% endif %}
  <meta name="author" content="{{ site.author }}" />
  <meta name="robots" content="{{ robotsContent }}" />
  <link rel="canonical" href="{{ canonicalUrl }}" />
  <link rel="sitemap" type="application/xml" href="{{ site.sitemap | absoluteUrl(site.url) }}" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="{{ ogType or 'website' }}" />
  <meta property="og:url" content="{{ canonicalUrl }}" />
  <meta property="og:title" content="{{ pageTitle }}" />
  <meta property="og:description" content="{{ metaDescription }}" />
  <meta property="og:image" content="{{ metaImageUrl }}" />
  <meta property="og:image:alt" content="{{ imageAltText }}" />
  <meta property="og:site_name" content="{{ site.title }}" />
  <meta property="og:locale" content="{{ site.locale }}" />
  <meta property="og:updated_time" content="{{ dateModified or site.dateModified }}" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content="{{ canonicalUrl }}" />
  <meta name="twitter:title" content="{{ pageTitle }}" />
  <meta name="twitter:description" content="{{ metaDescription }}" />
  <meta name="twitter:image" content="{{ metaImageUrl }}" />
  <meta name="twitter:image:alt" content="{{ imageAltText }}" />
  <meta name="twitter:site" content="@GreatPhotoArt" />

  <!-- Additional SEO -->
  <meta name="geo.region" content="BG-22" />
  <meta name="geo.placename" content="{{ site.address.city }}" />
  <meta name="geo.position" content="{{ site.geo.latitude }};{{ site.geo.longitude }}" />
  <meta name="ICBM" content="{{ site.geo.latitude }}, {{ site.geo.longitude }}" />
  <meta name="language" content="Bulgarian" />
  <link rel="alternate" hreflang="{{ site.language }}" href="{{ canonicalUrl }}" />
  <link rel="alternate" hreflang="x-default" href="{{ canonicalUrl }}" />

  <!-- Structured Data - Organization / Local Business -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": ["EducationalOrganization", "LocalBusiness"],
    "@id": {{ "#organization" | absoluteUrl(site.url) | json | safe }},
    "name": {{ site.title | json | safe }},
    "alternateName": {{ "Грейт Фото Арт" | json | safe }},
    "url": {{ "" | absoluteUrl(site.url) | json | safe }},
    "logo": {{ site.defaultImage | absoluteUrl(site.url) | json | safe }},
    "image": {{ metaImageUrl | json | safe }},
    "description": {{ site.description | json | safe }},
    "foundingDate": {{ (site.foundingYear + "") | json | safe }},
    "telephone": {{ site.phone | json | safe }},
    "email": {{ site.email | json | safe }},
    "address": {
      "@type": "PostalAddress",
      "streetAddress": {{ site.address.street | json | safe }},
      "addressLocality": {{ site.address.city | json | safe }},
      "addressRegion": {{ site.address.region | json | safe }},
      "postalCode": {{ site.address.postalCode | json | safe }},
      "addressCountry": {{ site.address.country | json | safe }}
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": {{ site.geo.latitude | json | safe }},
      "longitude": {{ site.geo.longitude | json | safe }}
    },
    "location": [
      {% for location in site.locations %}
      {
        "@type": "Place",
        "name": {{ location.name | json | safe }},
        "address": {
          "@type": "PostalAddress",
          "streetAddress": {{ location.street | json | safe }},
          "addressLocality": {{ location.city | json | safe }},
          "addressRegion": {{ location.region | json | safe }},
          "postalCode": {{ location.postalCode | json | safe }},
          "addressCountry": {{ location.country | json | safe }}
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": {{ location.latitude | json | safe }},
          "longitude": {{ location.longitude | json | safe }}
        }
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ],
    "sameAs": [
      {{ site.social.facebook | json | safe }},
      {{ site.social.twitter | json | safe }},
      {{ site.social.pinterest | json | safe }}
    ],
    "openingHoursSpecification": [
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        "opens": "10:00",
        "closes": "19:00"
      }
    ],
    "priceRange": {{ site.priceRange | json | safe }},
    "currenciesAccepted": {{ site.currenciesAccepted | json | safe }},
    "paymentAccepted": {{ site.paymentAccepted | json | safe }},
    "areaServed": [
      {% for area in site.areaServed %}{{ area | json | safe }}{% if not loop.last %},{% endif %}{% endfor %}
    ]
  }
  </script>

  <!-- Structured Data - Website -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": {{ "#website" | absoluteUrl(site.url) | json | safe }},
    "name": {{ site.title | json | safe }},
    "url": {{ "" | absoluteUrl(site.url) | json | safe }},
    "inLanguage": {{ site.language | json | safe }},
    "publisher": {
      "@id": {{ "#organization" | absoluteUrl(site.url) | json | safe }}
    }
  }
  </script>

  <!-- Structured Data - Current Web Page -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": {{ canonicalUrl | json | safe }},
    "url": {{ canonicalUrl | json | safe }},
    "name": {{ pageTitle | json | safe }},
    "description": {{ metaDescription | json | safe }},
    "inLanguage": {{ site.language | json | safe }},
    "dateModified": {{ (dateModified or site.dateModified) | json | safe }},
    "isPartOf": {
      "@id": {{ "#website" | absoluteUrl(site.url) | json | safe }}
    },
    "about": {
      "@id": {{ "#organization" | absoluteUrl(site.url) | json | safe }}
    },
    "primaryImageOfPage": {
      "@type": "ImageObject",
      "url": {{ metaImageUrl | json | safe }},
      "caption": {{ imageAltText | json | safe }}
    }
  }
  </script>

  {% if isCourseSection %}
  <!-- Structured Data - Course Catalog -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": {{ "Курсове по фотография от Great Photo Art" | json | safe }},
    "itemListElement": [
      {% for course in site.courses %}
      {
        "@type": "ListItem",
        "position": {{ loop.index }},
        "url": {{ course.url | absoluteUrl(site.url) | json | safe }},
        "item": {
          "@type": "Course",
          "@id": {{ (course.url + "#course") | absoluteUrl(site.url) | json | safe }},
          "name": {{ course.name | json | safe }},
          "description": {{ course.description | json | safe }},
          "url": {{ course.url | absoluteUrl(site.url) | json | safe }},
          "image": {{ course.image | absoluteUrl(site.url) | json | safe }},
          "inLanguage": {{ site.language | json | safe }},
          "educationalLevel": {{ course.audience | json | safe }},
          "courseMode": {{ course.mode | json | safe }},
          "timeRequired": {{ course.duration | json | safe }},
          "provider": {
            "@id": {{ "#organization" | absoluteUrl(site.url) | json | safe }}
          },
          "offers": {
            "@type": "Offer",
            "url": {{ course.url | absoluteUrl(site.url) | json | safe }},
            "availability": "https://schema.org/InStock",
            "category": "Paid"
          }
        }
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
  </script>
  {% endif %}

  {% if isPhotographySection %}
  <!-- Structured Data - Photography Services -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": {{ "Професионални фотографски услуги от Great Photo Art" | json | safe }},
    "itemListElement": [
      {% for service in site.services %}
      {
        "@type": "ListItem",
        "position": {{ loop.index }},
        "url": {{ service.url | absoluteUrl(site.url) | json | safe }},
        "item": {
          "@type": "Service",
          "@id": {{ (service.url + "#service") | absoluteUrl(site.url) | json | safe }},
          "name": {{ service.name | json | safe }},
          "description": {{ service.description | json | safe }},
          "url": {{ service.url | absoluteUrl(site.url) | json | safe }},
          "provider": {
            "@id": {{ "#organization" | absoluteUrl(site.url) | json | safe }}
          },
          "areaServed": [
            {% for area in site.areaServed %}{{ area | json | safe }}{% if not loop.last %},{% endif %}{% endfor %}
          ]
        }
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
  </script>
  {% endif %}

  {% if isCourseLanding and site.faq %}
  <!-- Structured Data - FAQ -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {% for item in site.faq %}
      {
        "@type": "Question",
        "name": {{ item.question | json | safe }},
        "acceptedAnswer": {
          "@type": "Answer",
          "text": {{ item.answer | json | safe }}
        }
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
  </script>
  {% endif %}

  <!-- Breadcrumb Schema -->
  {% if breadcrumbs %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Начало",
        "item": {{ "" | absoluteUrl(site.url) | json | safe }}
      }{% for crumb in breadcrumbs %},
      {
        "@type": "ListItem",
        "position": {{ loop.index + 1 }},
        "name": {{ crumb.title | json | safe }},
        "item": {{ crumb.url | absoluteUrl(site.url) | json | safe }}
      }{% endfor %}
    ]
  }
  </script>
  {% endif %}

  <link href="{{ pathPrefix }}templates/js_wright/favicon.ico" rel="shortcut icon" type="image/vnd.microsoft.icon" />
  <!-- Removed old Admiror Gallery CSS - files don't exist, using modern galleries now -->
  <link rel="stylesheet" href="{{ pathPrefix }}templates/js_wright/wright/bootstrap/css/bootstrap.min.css" type="text/css" />
  <link rel="stylesheet" href="{{ pathPrefix }}templates/js_wright/wright/fontawesomemore/css/font-awesome.css" type="text/css" />
  <link rel="stylesheet" href="{{ pathPrefix }}templates/js_wright/wright/css/typography.css" type="text/css" />
  <link rel="stylesheet" href="{{ pathPrefix }}templates/js_wright/wright/css/joomla25.css" type="text/css" />
  <link rel="stylesheet" href="{{ pathPrefix }}templates/js_wright/css/1_template.css" type="text/css" />
  <link rel="stylesheet" href="{{ pathPrefix }}templates/js_wright/css/style-theme1.css" type="text/css" />
  <link rel="stylesheet" href="{{ pathPrefix }}css/nivo-slider.css" type="text/css" />
  <link rel="stylesheet" href="{{ pathPrefix }}css/custom-styles.css" type="text/css" />

  <!-- Fancybox for Image Galleries -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fancyapps/ui@6.1.14/dist/fancybox/fancybox.css" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fancyapps/ui@6.1.14/dist/fancybox/fancybox.css" /></noscript>

  <!-- Removed old Mootools and Admiror Gallery JS - files don't exist -->
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js" type="text/javascript"></script>
  <script src="https://code.jquery.com/jquery-migrate-3.5.2.min.js" type="text/javascript"></script>
  <script src="https://cdn.jsdelivr.net/npm/nivo-slider@3.2.0/jquery.nivo.slider.pack.js" type="text/javascript" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/@fancyapps/ui@6.1.14/dist/fancybox/fancybox.umd.js" type="text/javascript" defer></script>

  <!-- Web Vitals optimization -->
  <style>
    /* Critical CSS for above-the-fold content */
    body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif; color: #2f3437; }
    .body-bg { background: #f5f8ee; }
    #page { max-width: 1200px; margin: 0 auto; background: #fff; }
    img { max-width: 100%; height: auto; }
    /* Reduce CLS for images */
    .nivoSlider img { aspect-ratio: 960/460; object-fit: cover; }
  </style>
</head>

