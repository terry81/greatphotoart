<head>
  <meta charset="utf-8" />
  <meta name="theme-color" content="#A5BD33" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
  <meta http-equiv="content-type" content="text/html; charset=utf-8" />

  <!-- SEO Meta Tags -->
  <title>{{ title }}</title>
  <meta name="description" content="{{ description or site.description }}" />
  <meta name="keywords" content="{{ keywords or site.keywords }}" />
  <meta name="author" content="{{ site.author }}" />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <link rel="canonical" href="{{ site.url }}{{ page.url }}" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
  <meta property="og:title" content="{{ title }}" />
  <meta property="og:description" content="{{ description or site.description }}" />
  <meta property="og:image" content="{{ site.url }}images/GPA_logo.jpg" />
  <meta property="og:site_name" content="Great Photo Art" />
  <meta property="og:locale" content="bg_BG" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content="{{ site.url }}{{ page.url }}" />
  <meta name="twitter:title" content="{{ title }}" />
  <meta name="twitter:description" content="{{ description or site.description }}" />
  <meta name="twitter:image" content="{{ site.url }}images/GPA_logo.jpg" />
  <meta name="twitter:site" content="@GreatPhotoArt" />

  <!-- Additional SEO -->
  <meta name="geo.region" content="BG-22" />
  <meta name="geo.placename" content="София" />
  <meta name="geo.position" content="42.6977;23.3219" />
  <meta name="ICBM" content="42.6977, 23.3219" />
  <meta name="language" content="Bulgarian" />
  <meta name="revisit-after" content="7 days" />
  <link rel="alternate" hreflang="bg" href="{{ site.url }}{{ page.url }}" />
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ page.url }}" />

  <!-- Structured Data - Local Business & Organization -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "EducationalOrganization",
    "name": "Great Photo Art",
    "alternateName": "Грейт Фото Арт",
    "url": "{{ site.url }}",
    "logo": "{{ site.url }}images/GPA_logo.jpg",
    "description": "{{ site.description }}",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "бул. Васил Левски 57",
      "addressLocality": "София",
      "addressRegion": "София-град",
      "postalCode": "1142",
      "addressCountry": "BG"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 42.6977,
      "longitude": 23.3219
    },
    "telephone": "{{ site.phone }}",
    "email": "{{ site.email }}",
    "sameAs": [
      "{{ site.social.facebook }}",
      "{{ site.social.twitter }}",
      "{{ site.social.pinterest }}"
    ],
    "openingHoursSpecification": [
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        "opens": "10:00",
        "closes": "19:00"
      }
    ],
    "priceRange": "$$",
    "currenciesAccepted": "BGN",
    "paymentAccepted": "Cash, Bank Transfer",
    "areaServed": ["София", "Пловдив", "България"],
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Фотографски услуги и курсове",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Course",
            "name": "Курс по фотография за начинаещи",
            "description": "Професионално обучение по фотография за начинаещи в София",
            "provider": {
              "@type": "Organization",
              "name": "Great Photo Art"
            }
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Продуктова фотография",
            "description": "Професионална продуктова фотография за бизнеси",
            "provider": {
              "@type": "Organization",
              "name": "Great Photo Art"
            }
          }
        }
      ]
    }
  }
  </script>

  <link href="{{ pathPrefix }}templates/js_wright/favicon.ico" rel="shortcut icon" type="image/vnd.microsoft.icon" />
  <!-- Removed old Admiror Gallery CSS - files don't exist, using modern galleries now -->
  <link rel="stylesheet" href="{{ pathPrefix }}templates/js_wright/wright/bootstrap/css/bootstrap.min.css" type="text/css" />
  <link rel="stylesheet" href="{{ pathPrefix }}templates/js_wright/wright/fontawesomemore/css/font-awesome.css" type="text/css" />
  <link rel="stylesheet" href="{{ pathPrefix }}templates/js_wright/wright/css/typography.css" type="text/css" />
  <link rel="stylesheet" href="{{ pathPrefix }}templates/js_wright/wright/css/joomla25.css" type="text/css" />
  <link rel="stylesheet" href="{{ pathPrefix }}templates/js_wright/css/1_template.css" type="text/css" />
  <link rel="stylesheet" href="{{ pathPrefix }}templates/js_wright/css/style-theme1.css" type="text/css" />
  <!-- Removed old Nivo Slider CSS - using modern slick slider now -->

  <!-- Removed old Mootools and Admiror Gallery JS - files don't exist -->
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/1.8.2/jquery.min.js" type="text/javascript"></script>
  <!-- Removed old Nivo Slider JS - using modern slick slider now -->
</head>

