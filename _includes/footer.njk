<div class="wrapper-footer">
  <footer class="footer" id="footer" role="contentinfo">
    <div class="container">
      <div class="row">
        <div class="module mod_1 first no_title span4">
          <div class="newsflash">
            <h2 class="footer-heading">{{ site.title }}</h2>
            <p>Фотографска школа и професионално студио за курсове, продуктова, рекламна и корпоративна фотография.</p>
            <p class="footer-copy">© {% year %} Great Photo Art. Всички права запазени.</p>
          </div>
        </div>

        <div class="module mod_2 span4">
          <h2 class="footer-heading">Контакти</h2>
          <address class="footer-contact">
            <p>
              <strong>Телефон:</strong> <a href="tel:+359884779121">{{ site.phone }}</a>
            </p>
            <p>
              <strong>Email:</strong> <a href="mailto:{{ site.email }}">{{ site.email }}</a>
            </p>
            <p>
              <strong>Адрес:</strong> {{ site.address.street }}, {{ site.address.city }}
            </p>
          </address>
        </div>

        <div class="module mod_3 last span4">
          <h2 class="footer-heading">Бързи връзки</h2>
          <nav aria-label="Връзки в долния колонтитул" class="footer-links">
            <a href="{{ pathPrefix }}foto-kursove.html">Курсове</a>
            <a href="{{ pathPrefix }}photography.html">Фотография</a>
            <a href="{{ pathPrefix }}contacts.html">Контакти</a>
          </nav>
          <nav aria-label="Социални мрежи" class="footer-social">
            <a href="{{ site.social.facebook }}" aria-label="Facebook" rel="noopener noreferrer" target="_blank">Facebook</a>
            <a href="{{ site.social.twitter }}" aria-label="Twitter" rel="noopener noreferrer" target="_blank">Twitter</a>
            <a href="{{ site.social.pinterest }}" aria-label="Pinterest" rel="noopener noreferrer" target="_blank">Pinterest</a>
          </nav>
        </div>
      </div>
    </div>
  </footer>
</div>

<!-- Floating Contact Button -->
<a href="tel:+359884779121" class="floating-contact-btn" aria-label="Обадете се сега" title="Обадете се сега: +359 884 779 121">
  <span class="phone-icon">📞</span>
</a>

<script src="{{ pathPrefix }}templates/js_wright/wright/bootstrap/js/bootstrap.min.js" defer></script>
<script type="text/javascript">
  document.addEventListener('DOMContentLoaded', function() {
    // Bootstrap dropdown functionality
    if (typeof jQuery !== 'undefined') {
      jQuery('.dropdown-toggle').dropdown();
    }

    // Lazy load images with native lazy loading fallback
    if ('loading' in HTMLImageElement.prototype) {
      const lazyImages = document.querySelectorAll('img[loading="lazy"]');
      lazyImages.forEach(img => {
        if (img.dataset.src) {
          img.src = img.dataset.src;
        }
      });
    }

    // Initialize Fancybox for galleries if available
    if (typeof Fancybox !== 'undefined') {
      Fancybox.bind("[data-fancybox]", {
        animated: true,
        showClass: "fancybox-fadeIn",
        hideClass: "fancybox-fadeOut",
      });
    }
  });
</script>

