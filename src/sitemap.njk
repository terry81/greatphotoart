---
permalink: sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
{%- for item in collections.all %}
{%- set itemUrl = item.url or "" %}
{%- if itemUrl and ("404" not in itemUrl) %}
{%- set isHome = itemUrl == "/" or itemUrl == "/index.html" %}
{%- set isNested = "/" in (itemUrl | replace("/index.html", "") | replace("/", "", 1)) %}
  <url>
    <loc>{{ itemUrl | absoluteUrl(site.url) }}</loc>
    <lastmod>{{ item.date.toISOString().slice(0, 10) }}</lastmod>
    <changefreq>{% if isHome %}weekly{% else %}monthly{% endif %}</changefreq>
    <priority>{% if isHome %}1.0{% elif isNested %}0.7{% else %}0.8{% endif %}</priority>
{%- if item.data.image %}
    <image:image>
      <image:loc>{{ item.data.image | absoluteUrl(site.url) }}</image:loc>
      <image:title>{{ (item.data.imageAlt or item.data.title) | cleanTitle | escape }}</image:title>
    </image:image>
{%- endif %}
  </url>
{%- endif %}
{%- endfor %}
</urlset>
