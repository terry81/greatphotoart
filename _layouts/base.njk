<!DOCTYPE html>
<html lang="bg">
{% include "head.njk" %}
<body class="contentpane">
  <a href="#main-content" class="skip-to-content">Преминете към съдържанието</a>
  <div class="body-bg">
    <div id="page" class="container">
      {% include "header.njk" %}
      {% include "navigation.njk" %}

      <main id="main-content" class="row" role="main">
        <section class="span12" id="main">
          {% if breadcrumbs %}
          <nav aria-label="Навигация чрез галета" class="breadcrumb-nav">
            <ol class="breadcrumb" itemscope itemtype="https://schema.org/BreadcrumbList">
              <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                <a href="{{ pathPrefix }}index.html" itemprop="item"><span itemprop="name">Начало</span></a>
                <meta itemprop="position" content="1" />
              </li>
              {% for crumb in breadcrumbs %}
              <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                {% if loop.last %}
                <span itemprop="name" aria-current="page">{{ crumb.title }}</span>
                <meta itemprop="item" content="{{ crumb.url | absoluteUrl(site.url) }}" />
                {% else %}
                <a href="{{ pathPrefix }}{{ crumb.url }}" itemprop="item"><span itemprop="name">{{ crumb.title }}</span></a>
                {% endif %}
                <meta itemprop="position" content="{{ loop.index + 1 }}" />
              </li>
              {% endfor %}
            </ol>
          </nav>
          {% endif %}
          <div id="system-message-container"></div>
          {{ content | safe }}
        </section>
      </main>

      {% include "footer.njk" %}
    </div>
  </div>
</body>
</html>

